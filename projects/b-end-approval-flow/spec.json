{
  "version": "spec-v2",
  "meta": {
    "project": "b-end-approval-flow",
    "title": "企业采购审批流（v2.0 多级金额路由与驳回重提）",
    "doc_version": "v2.0",
    "platform_default": "web-admin",
    "entry_node": "F_LIST",
    "prd_source": "prd.md"
  },
  "vars": [
    {
      "id": "leader_decision",
      "label": "直属主管初审结论",
      "kind": "branch",
      "default": "approve",
      "diamond": "D_AUDIT_LEADER",
      "nodes": ["F_LEADER", "D_AUDIT_LEADER"],
      "options": [
        {
          "id": "approve",
          "label": "同意",
          "target": "D_AMOUNT_50K"
        },
        {
          "id": "reject",
          "label": "驳回（保留草稿）",
          "target": "F_REJECTED"
        }
      ]
    },
    {
      "id": "amount_tier",
      "label": "采购金额区间",
      "kind": "branch",
      "default": "gt_50k",
      "diamond": "D_AMOUNT_50K",
      "nodes": ["F_FORM", "F_LEADER", "D_AMOUNT_50K", "F_FINANCE"],
      "options": [
        {
          "id": "le_50k",
          "label": "<=5万（单级办结）",
          "target": "F_DONE"
        },
        {
          "id": "gt_50k",
          "label": ">5万（加签财务总监）",
          "target": "F_FINANCE"
        }
      ]
    },
    {
      "id": "audit_decision",
      "label": "财务总监复核结论",
      "kind": "branch",
      "default": "approve",
      "diamond": "D_AUDIT_OK",
      "nodes": ["F_FINANCE", "D_AUDIT_OK", "F_DONE", "F_REJECTED"],
      "options": [
        {
          "id": "approve",
          "label": "复核通过",
          "target": "F_DONE"
        },
        {
          "id": "reject",
          "label": "复核驳回（保留草稿）",
          "target": "F_REJECTED"
        }
      ]
    }
  ],
  "nodes": {
    "F_LIST": {
      "page": "p-apply-list",
      "title": "采购申请列表",
      "change": "unchanged",
      "anno": [
        ["列表入口", "展示全部采购单及当前审批节点状态，支持点击「+ 新建采购单」或驳回单据「重新编辑」直接流转。"]
      ]
    },
    "F_FORM": {
      "page": "p-apply-form",
      "title": "新建/编辑采购申请单",
      "change": "modified",
      "anno": [
        ["金额阈值提示（v2.0 修改）", "填写采购金额与采购事由，系统提示 > 50,000 元将在直属主管初审同意后加签财务总监复核。"],
        ["实时联动", "修改采购金额或切换右侧「采购金额区间」后点击「确认发起审批」，将进入直属主管初审。"]
      ]
    },
    "F_LEADER": {
      "page": "p-leader-audit",
      "title": "直属主管初审",
      "change": "unchanged",
      "anno": [
        ["全量必经初审", "所有采购单提交后均先由直属主管初审：点击「同意」按金额区间路由（<=5万直接办结，>5万加签财务复核）；点击「驳回」保留草稿。"]
      ]
    },
    "D_AUDIT_LEADER": {
      "page": "p-leader-audit",
      "title": "主管是否同意？",
      "isDecision": true,
      "branchVar": "leader_decision",
      "change": "modified",
      "anno": [
        ["初审分流（v2.0 升级）", "直属主管同意后进入金额阈值判断节点（D_AMOUNT_50K）；驳回不再直接作废，统一流转至草稿保留页（F_REJECTED）。"]
      ]
    },
    "D_AMOUNT_50K": {
      "page": "p-apply-form",
      "title": "金额 > 5万？",
      "isDecision": true,
      "branchVar": "amount_tier",
      "change": "new",
      "anno": [
        ["金额阈值路由（v2.0 新增）", "主管初审通过后判断采购单金额：<= 5万直接进入审批通过结果页（F_DONE）；> 5万自动加签进入财务总监复核（F_FINANCE）。"]
      ]
    },
    "F_FINANCE": {
      "page": "p-finance-audit",
      "title": "财务总监复核",
      "change": "new",
      "anno": [
        ["大额加签复核（v2.0 新增）", "仅当采购金额 > 5万元且直属主管同意后触发，财务总监核查预算归属并填写复核意见后选择通过或驳回。"]
      ]
    },
    "D_AUDIT_OK": {
      "page": "p-finance-audit",
      "title": "复核是否通过？",
      "isDecision": true,
      "branchVar": "audit_decision",
      "change": "new",
      "anno": [
        ["财务复核分流（v2.0 新增）", "复核通过流转至审批通过结果页（F_DONE）；复核驳回同样流转至草稿保留提示页（F_REJECTED）。"]
      ]
    },
    "F_DONE": {
      "page": "p-audit-done",
      "title": "审批通过结果页",
      "change": "unchanged",
      "anno": [
        ["流程办结", "展示审批通过状态与完整审批轨迹，可返回采购申请列表或继续新建采购单。"]
      ]
    },
    "F_REJECTED": {
      "page": "p-audit-rejected",
      "title": "驳回保留草稿提示页",
      "change": "new",
      "anno": [
        ["驳回重提闭环（v2.0 新增）", "无论是直属主管还是财务总监驳回，均完整保留原采购单草稿，点击「重新编辑」直接回跳填报页（F_FORM）修改重提。"]
      ]
    }
  },
  "pages": {
    "p-apply-list": {
      "frame": "wide",
      "title": "采购申请列表页",
      "components": [
        { "comp_id": "list.new.btn", "comp_name": "新建采购单按钮", "role": "control" },
        { "comp_id": "list.filter.select", "comp_name": "审批状态筛选器", "role": "control" },
        { "comp_id": "list.search.input", "comp_name": "采购单搜索框", "role": "control" },
        { "comp_id": "list.row1.view.btn", "comp_name": "查看大额采购单详情按钮", "role": "control" },
        { "comp_id": "list.row2.reedit.btn", "comp_name": "驳回重提编辑按钮", "role": "control" },
        { "comp_id": "list.row3.view.btn", "comp_name": "查看已通过采购单详情按钮", "role": "control" }
      ]
    },
    "p-apply-form": {
      "frame": "wide",
      "title": "新建/编辑采购申请单页",
      "components": [
        { "comp_id": "form.back.btn", "comp_name": "返回采购列表按钮", "role": "nav" },
        { "comp_id": "form.amount.input", "comp_name": "采购金额输入框", "role": "control" },
        { "comp_id": "form.reason.input", "comp_name": "采购事由输入框", "role": "control" },
        { "comp_id": "form.draft.btn", "comp_name": "保存草稿按钮", "role": "control" },
        { "comp_id": "form.submit.btn", "comp_name": "提交采购申请按钮", "role": "control" }
      ]
    },
    "p-leader-audit": {
      "frame": "wide",
      "title": "直属主管审批弹窗页",
      "components": [
        { "comp_id": "audit.close.btn", "comp_name": "关闭审批弹窗按钮", "role": "control" },
        { "comp_id": "audit.comment.input", "comp_name": "直属主管审批备注输入框", "role": "control" },
        { "comp_id": "audit.reject.btn", "comp_name": "直属主管驳回按钮", "role": "control" },
        { "comp_id": "audit.approve.btn", "comp_name": "直属主管同意按钮", "role": "control" }
      ]
    },
    "p-finance-audit": {
      "frame": "wide",
      "title": "财务总监复核页",
      "components": [
        { "comp_id": "finance.back.btn", "comp_name": "返回待办列表按钮", "role": "nav" },
        { "comp_id": "finance.comment.input", "comp_name": "财务总监复核意见输入框", "role": "control" },
        { "comp_id": "finance.reject.btn", "comp_name": "财务总监驳回按钮", "role": "control" },
        { "comp_id": "finance.approve.btn", "comp_name": "财务总监复核通过按钮", "role": "control" }
      ]
    },
    "p-audit-done": {
      "frame": "wide",
      "title": "审批通过结果页",
      "components": [
        { "comp_id": "done.back_list.btn", "comp_name": "返回采购申请列表按钮", "role": "nav" },
        { "comp_id": "done.new_order.btn", "comp_name": "继续新建采购单按钮", "role": "control" }
      ]
    },
    "p-audit-rejected": {
      "frame": "wide",
      "title": "驳回保留草稿提示页",
      "components": [
        { "comp_id": "rejected.back_list.btn", "comp_name": "返回列表暂不修改按钮", "role": "nav" },
        { "comp_id": "rejected.reedit.btn", "comp_name": "重新编辑并提交按钮", "role": "control" }
      ]
    }
  },
  "spec_cards": [
    {
      "id": "SC_AMOUNT_THRESHOLD",
      "title": "改点 1：主管初审后按 5 万元阈值分流加签",
      "page": "p-apply-form",
      "anchor": "form.amount.input",
      "body": "所有采购单均先由直属主管初审；主管同意后以 50,000 元为阈值路由（D_AMOUNT_50K）：<= 5万直接办结通过；> 5万自动加签财务总监复核。"
    },
    {
      "id": "SC_FINANCE_REVIEW",
      "title": "改点 2：新增财务总监大额复核节点",
      "page": "p-finance-audit",
      "anchor": "finance.approve.btn",
      "body": "新增财务总监复核页，展示直属主管初审结论与预算池归属，要求填写复核意见（finance.comment.input）后方可通过或驳回。"
    },
    {
      "id": "SC_REJECT_DRAFT",
      "title": "改点 3：驳回后保留草稿支持一键重新编辑",
      "page": "p-audit-rejected",
      "anchor": "rejected.reedit.btn",
      "body": "无论是主管初审驳回还是财务复核驳回，均保留原采购单金额与事由草稿数据，在驳回提示页点击「重新编辑」（rejected.reedit.btn）可直接回跳填报页修改重提。"
    }
  ]
}
