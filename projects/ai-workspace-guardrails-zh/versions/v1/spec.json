  "spec_cards": [
    {
      "id": "SC-01",
      "title": "月度预算水位监控与风控入口收敛",
      "page": "p-usage-dash",
      "anchor": "dash.guardrail.btn",
      "body": "在团队额度总览顶栏收敛「配置预算风控」与「申请临时加额」操作，联动三联 KPI 卡实时展示已用额度进度（$1,840 / $2,000 [92%]）、活跃密钥消耗速率与待批单数。"
    },
    {
      "id": "SC-02",
      "title": "月度硬顶熔断与 $500 免审阈值双轨策略",
      "page": "p-guardrail-modal",
      "anchor": "policy.cap.input",
      "body": "支持空间 Owner 配置月度预算硬顶金额（校验不低于当月已发生账单）与单次免审放行阈值（默认 $500），达 100% 硬顶时可按策略自动暂停超限密钥或仅推送企微/Webhook 告警。"
    },
    {
      "id": "SC-03",
      "title": "临时加额实时阶梯分流（<= $500 免审 / > $500 加签）",
      "page": "p-quota-request",
      "anchor": "req.amount.input",
      "body": "成员输入申请追加金额时实时触发 setVar('request_tier', ...) 预判审批路径：<= $500 自动放行；> $500（如 $800 大促峰值）关联成本中心流转负责人加签，次月 1 日自动回落原上限。"
    },
    {
      "id": "SC-04",
      "title": "消耗速率比对复核与秒级密钥解封",
      "page": "p-owner-approval",
      "anchor": "approve.confirm.btn",
      "body": "审批台内置目标密钥近 24h 消耗速率、5xx 重试率与同空间均值对比表以排除死循环刷量；点击「同意加额并解封」后 10 秒内恢复密钥正常转发并落盘不可篡改审计流水。"
    }
