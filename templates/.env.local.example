# OpenPM 本地凭证配置模板（请复制为 .env.local 后填入，严禁提交到 Git）

# ===== 1. 企业微信（推荐：智能机器人 API 长连接模式，免域名直通文档/微盘/消息） =====
WECOM_BOT_ID=your_bot_id_here
WECOM_BOT_SECRET=your_bot_secret_here
# （可选）若仅使用群机器人通知，填写 Webhook
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key
# （可选）默认微盘/文档目标目录 ID
WECOM_FOLDER_ID=

# ===== 2. Confluence（PAT 个人访问令牌模式） =====
WIKI_BASE_URL=https://wiki.yourcompany.com
CONFLUENCE_PAT=your_personal_access_token
CONFLUENCE_SPACE_KEY=PM

# ===== 3. 飞书文档（可选） =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
